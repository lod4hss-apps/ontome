{% extends 'base.html.twig' %}

{% block title %} {{ parent() }} - Properties {% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <p class="pull-right">
        <button type="button" class="btn btn-default" id="btn-show-all-namespaces">Show all namespaces</button>
    </p>
    <h3>Properties</h3>
    <table class="table table-striped" id="property-table">
        <thead>
            <tr>
                <th class="text-right">Domain</th>
                <th></th>
                <th>Identifier</th>
                <th class="text-center">Property label</th>
                <th></th>
                <th>Range</th>
                <th>Namespace</th>
                <th>Last updated</th>
                <th>id_namespace</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            var showAll = false;
            var tableProperties = $('#property-table').DataTable({
                serverSide: true,
                ajax: {
                    url: '{{ path('property_datatable') }}',
                    data: function (d) { d.showAll = showAll ? '1' : '0'; }
                },
                columns: [
                    { data: 'domain' },
                    { data: 'domainQuant' },
                    { data: 'identifier' },
                    { data: 'label' },
                    { data: 'rangeQuant' },
                    { data: 'range' },
                    { data: 'namespace' },
                    { data: 'updated' },
                    { data: 'nsId' }
                ],
                order: [[2, 'asc']],
                pageLength: 50,
                columnDefs: [
                    { orderable: false, targets: [0, 1, 4, 5, 6, 7] },
                    { visible: false, targets: 8 }
                ]
            });

            $('#btn-show-all-namespaces').click(function () {
                showAll = !showAll;
                $(this).toggleClass('btn-primary btn-default')
                       .html(showAll ? 'Hide unselected namespaces' : 'Show all namespaces');
                tableProperties.ajax.reload();
            });

            $('.dataTables_paginate').click(function () {
                $([document.documentElement, document.body]).animate({
                    scrollTop: $(this).closest('.dataTables_wrapper').prevAll('h3').offset().top
                }, 1000);
            });
        });
    </script>
{% endblock %}