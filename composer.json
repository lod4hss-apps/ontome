{
    "name": "phn/ontome",
    "license": "proprietary",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "doctrine/doctrine-bundle": "^2.4",
        "doctrine/doctrine-migrations-bundle": "^3.0",
        "doctrine/orm": "^2.12",
        "egulias/email-validator": "^4.0",
        "laminas/laminas-escaper": "^2.8",
        "laminas/laminas-stdlib": "^3.10",
        "laminas/laminas-validator": "^3.20",
        "nelmio/cors-bundle": "^2.0",
        "phpoffice/phpword": "^1.4.0",
        "stof/doctrine-extensions-bundle": "^1.7",
        "symfony/asset": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/flex": "^2.1",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/polyfill-apcu": "^1.0",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/twig": "^3.0.4"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "rector/rector": "^2.6",
        "symfony/dotenv": "7.4.*",
        "symfony/maker-bundle": "^1.54",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install --symlink --relative %PUBLIC_DIR%": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "7.4.*"
        },
        "symfony-app-dir": "app",
        "symfony-bin-dir": "bin",
        "symfony-var-dir": "var",
        "symfony-web-dir": "web",
        "symfony-tests-dir": "tests",
        "symfony-assets-install": "relative",
        "incenteev-parameters": {
            "file": "app/config/parameters.yml"
        },
        "branch-alias": null
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "platform": {
            "php": "8.2.30"
        },
        "audit": {
            "block-insecure": false
        },
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    }
}
